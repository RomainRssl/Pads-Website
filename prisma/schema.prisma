generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── NextAuth required models ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application models ────────────────────────────────────────────────────────
// Role is stored as String ("USER" | "ADMIN") — SQLite does not support enums

model Event {
  id          String         @id @default(cuid())
  title       String
  date        DateTime
  game        String
  track       String
  cars        String         // JSON array of car classes, max 5
  description    String?
  imageUrl       String?
  serverName     String?
  serverPassword String?
  raceHistory RaceHistory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
}

model RaceHistory {
  id         String   @id @default(cuid())
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title      String
  date       DateTime
  track      String
  image      String?
  rawResults String
  createdAt  DateTime @default(now())
  createdBy  String
}

// Singleton row — configuration du serveur Discord (remplie via /setup)
model GuildConfig {
  id           String   @id @default("singleton")
  guildId      String
  webhookUrl   String
  adminRoleId  String?
  configuredAt DateTime @default(now())
}

// ── Sim Racing stats ──────────────────────────────────────────────────────────

model Team {
  id      String   @id @default(cuid())
  name    String   @unique
  xp      Int      @default(0)
  players Player[]
}

model Player {
  id              String              @id @default(cuid())
  username        String              @unique
  discordUsername String?
  discordId       String?             @unique
  xp              Int                 @default(0)
  money           Int                 @default(0)
  reputation      Int                 @default(50)
  licensePoints   Int                 @default(0)
  totalRaces      Int                 @default(0)
  finishedRaces   Int                 @default(0)
  cleanRaces      Int                 @default(0)
  teamId          String?
  team            Team?               @relation(fields: [teamId], references: [id])
  raceResults     RaceResult[]
  categories      PlayerCategory[]
  classStats      PlayerClassStats[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model LicenseConfig {
  id    String @id
  label String
  minXp Int
  color String @default("#CD7F32")
  order Int    @default(0)
}

model Category {
  id      String           @id @default(cuid())
  name    String           @unique
  order   Int              @default(0)
  players PlayerCategory[]
}

model PlayerCategory {
  playerId   String
  categoryId String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([playerId, categoryId])
}

model RaceSession {
  id                String       @id @default(cuid())
  durationMin       Int
  processedAt       DateTime     @default(now())
  processedBy       String
  trackVenue        String?
  trackEvent        String?
  sessionType       String?
  warningThreshold  Int          @default(4)
  sanctionThreshold Int          @default(8)
  results           RaceResult[]
}

model RaceResult {
  id              String      @id @default(cuid())
  playerId        String
  player          Player      @relation(fields: [playerId], references: [id])
  raceSessionId   String
  raceSession     RaceSession @relation(fields: [raceSessionId], references: [id])
  position        Int
  xpGained        Int
  moneyGained     Int
  isClean         Boolean     @default(true)
  carClass        String?
  incidents       Int         @default(0)
  reputationDelta Int         @default(0)
  ladderDelta     Int         @default(0)
  laps            Int?
  bestLapTimeSec  Float?
  finishStatus    String?
  teamName        String?
  offtrackCount  Int?
  contactCount   Int?
  avertCount     Int?
  sanctionCount  Int?
}

model PlayerClassStats {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  carClass     String
  classXp      Int      @default(0)
  ladderPoints Int      @default(0)

  @@unique([playerId, carClass])
}

model FormulaDefaults {
  id                     String @id @default("singleton")
  finishBonus            Float  @default(10)
  positionBase           Float  @default(10)
  positionMultiplier     Float  @default(1.5)
  podiumP1               Float  @default(10)
  podiumP2               Float  @default(7)
  podiumP3               Float  @default(5)
  incidentMalusPct       Float  @default(2)
  incidentMalusCap       Float  @default(20)
  moneyBasePerMin        Float  @default(50)
  coeffCourse            Float  @default(1)
  organizerSharePct      Float  @default(25)
  p1PrizePct             Float  @default(10)
  pLastMinPct            Float  @default(25)
  repBase          Float  @default(3)
  repFinishBonus   Float  @default(1)
  offtrackPenalty  Float  @default(0.25)
  contactPenalty   Float  @default(1)
  avertPenalty     Float  @default(1)
  sanctionPenalty  Float  @default(2)
  avertRatioMin    Float  @default(2)
  sanctionRatioMin Float  @default(4)
  forceThreshold   Float  @default(800)
  forceRatioMin    Float  @default(1.05)
  ladderCoeff_sm   Float  @default(4)
  ladderCoeff_md   Float  @default(3)
  ladderCoeff_lg   Float  @default(2)
}

// ── Constructeur Championship ────────────────────────────────────────────────

model ConstructorStandings {
  id                String   @id @default(cuid())
  carClass          String   // GT3, GTE, HYPERCAR
  constructorName   String   // Mercedes, Porsche, BMW, etc.
  seasonPoints      Int      @default(0)
  raceCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([carClass, constructorName])
}

model TrackRecord {
  id              String   @id @default(cuid())
  carClass        String   // GT3, GTE, HYPERCAR, LMP2, LMP3
  circuit         String
  constructorName String   // Constructor/Car model
  piloteName      String
  bestLapTime     Float    // In seconds
  raceDate        DateTime
  createdAt       DateTime @default(now())

  @@unique([carClass, circuit])
}

// ── Twitch multiplex ──────────────────────────────────────────────────────────

model TwitchStreamer {
  id          String   @id @default(cuid())
  username    String   @unique  // Twitch login (lowercase)
  displayName String?           // Synced from Twitch API
  addedAt     DateTime @default(now())
}

model TickerItem {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
