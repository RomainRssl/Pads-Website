generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── NextAuth required models ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application models ────────────────────────────────────────────────────────
// Role is stored as String ("USER" | "ADMIN") — SQLite does not support enums

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  game        String
  track       String
  car         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
}

// Singleton row — configuration du serveur Discord (remplie via /setup)
model GuildConfig {
  id           String   @id @default("singleton")
  guildId      String
  webhookUrl   String
  adminRoleId  String?
  configuredAt DateTime @default(now())
}

// ── Sim Racing stats ──────────────────────────────────────────────────────────

model Team {
  id      String   @id @default(cuid())
  name    String   @unique
  xp      Int      @default(0)
  players Player[]
}

model Player {
  id              String           @id @default(cuid())
  username        String           @unique
  discordUsername String?
  discordId       String?          @unique
  xp              Int              @default(0)
  money           Int              @default(0)
  reputation      Int              @default(0)
  licensePoints   Int              @default(0)
  totalRaces      Int              @default(0)
  finishedRaces   Int              @default(0)
  cleanRaces      Int              @default(0)
  teamId          String?
  team          Team?            @relation(fields: [teamId], references: [id])
  raceResults   RaceResult[]
  categories    PlayerCategory[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model LicenseConfig {
  id    String @id
  label String
  minXp Int
  color String @default("#CD7F32")
  order Int    @default(0)
}

model Category {
  id      String           @id @default(cuid())
  name    String           @unique
  order   Int              @default(0)
  players PlayerCategory[]
}

model PlayerCategory {
  playerId   String
  categoryId String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([playerId, categoryId])
}

model RaceSession {
  id          String       @id @default(cuid())
  durationMin Int
  processedAt DateTime     @default(now())
  processedBy String
  results     RaceResult[]
}

model RaceResult {
  id            String      @id @default(cuid())
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id])
  raceSessionId String
  raceSession   RaceSession @relation(fields: [raceSessionId], references: [id])
  position      Int
  xpGained      Int
  moneyGained   Int
  isClean       Boolean     @default(true)
}

// ── Twitch multiplex ──────────────────────────────────────────────────────────

model TwitchStreamer {
  id          String   @id @default(cuid())
  username    String   @unique  // Twitch login (lowercase)
  displayName String?           // Synced from Twitch API
  addedAt     DateTime @default(now())
}
