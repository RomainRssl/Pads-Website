# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL de votre application (changer en production)
NEXTAUTH_URL="http://localhost:3000"

# ── Discord OAuth2 (Discord Developer Portal → OAuth2) ────────────────────────
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ── Discord Bot (Discord Developer Portal → Bot) ──────────────────────────────
# Le bot doit être membre de votre serveur Discord
DISCORD_BOT_TOKEN=""
# Secret partagé avec le bot Discord pour les endpoints /api/players/*
BOT_API_SECRET=""

# ── Configuration du serveur Discord ─────────────────────────────────────────
# ID de votre serveur Discord (clic droit sur le serveur → Copier l'identifiant)
GUILD_ID=""
# ID du rôle qui donne accès au panel admin
ADMIN_ROLE_ID=""

# ── Discord Webhook ───────────────────────────────────────────────────────────
# Paramètres du serveur → Intégrations → Webhooks → Créer un webhook
DISCORD_WEBHOOK_URL=""

# ── Twitch API (optionnel — pour le statut LIVE en temps réel) ────────────────
# Créer une application sur https://dev.twitch.tv/console
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Domaine utilisé comme "parent" dans les embeds Twitch
# Dev : localhost  |  Production : votre-domaine.com  (sans https://)
NEXT_PUBLIC_SITE_DOMAIN="localhost"
